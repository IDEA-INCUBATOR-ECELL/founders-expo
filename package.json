{
  "name": "mgit-startup-expo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js --production",
    "test": "node --env-file-if-exists=.env.test --test tests/*.test.js",
    "format": "prettier --write src server shared tests package.json index.html README.md",
    "build:preview": "vite build --mode preview",
    "db:setup": "node scripts/setup-database.mjs",
    "db:migrate": "node scripts/migrate-sqlite.mjs",
    "db:check": "node scripts/check-database.mjs",
    "test:unit": "node --test tests/client-api.test.js tests/public-startup.test.js tests/submissions.test.js tests/database-config.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
