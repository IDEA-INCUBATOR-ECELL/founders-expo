# Server only: never use a VITE_ prefix or commit real secrets.
# Supabase Dashboard > Connect > Session pooler (IPv4), or direct connection.
SUPABASE_DB_URL=
# Optional path to the Supabase CA certificate if required for TLS validation.
SUPABASE_SSL_CA_FILE=
PORT=5173
# For a brand-new database only. Importing SQLite preserves the existing admin account.
ADMIN_EMAIL=ideaclub@gmail.com
ADMIN_PASSWORD=
COOKIE_SECURE=false
# For isolated PostgreSQL tests only; never enable against a remote host.
DATABASE_LOCAL_TEST=false
